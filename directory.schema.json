{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VINASIG/vinasig-org-directory/main/directory.schema.json",
  "title": "VINASIG Organization Directory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format",
    "organization",
    "inventoryDate",
    "updatedOn",
    "verification",
    "entries"
  ],
  "properties": {
    "$schema": { "const": "./directory.schema.json" },
    "format": { "const": 1 },
    "organization": { "const": "VINASIG" },
    "inventoryDate": { "$ref": "#/$defs/date" },
    "updatedOn": { "$ref": "#/$defs/date" },
    "verification": { "const": "not-independently-verified" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nullableText": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 500
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "platform",
        "identifier",
        "url",
        "email",
        "status",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "category": {
          "enum": ["organization", "contact", "social", "developer"]
        },
        "platform": { "type": "string", "minLength": 1, "maxLength": 80 },
        "identifier": { "$ref": "#/$defs/nullableText" },
        "url": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "email": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 254
        },
        "status": { "enum": ["listed", "incomplete"] },
        "notes": { "$ref": "#/$defs/nullableText" }
      }
    }
  }
}
